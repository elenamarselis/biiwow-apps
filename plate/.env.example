# Copy to .env.local and fill in. Values below are for the local Supabase stack (npm run db:start).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon / publishable key: safe in the browser, RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used for invites, demo seeding and deleting your login.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Free key from https://fdc.nal.usda.gov/api-key-signup.html (USDA search is off without it).
FDC_API_KEY=
# Where invite emails send people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = use bundled USDA / Open Food Facts fixtures instead of the internet (tests, offline demos).
FOOD_SOURCES_MOCK=0
